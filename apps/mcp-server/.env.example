# ── Transport ────────────────────────────────────────────────────────────────
# stdio (local dev) | http (hosted). Overridable with `--transport <kind>`.
ORBIT_TRANSPORT=stdio

# ── Workstream A (REST API) ──────────────────────────────────────────────────
ORBIT_API_URL=http://localhost:4000

# Repo this connection is bound to (single repo per workspace, v1).
ORBIT_REPO_ID=repo_demo

# ── Auth ─────────────────────────────────────────────────────────────────────
# Agent key registry: maps API keys → agents. Use a file OR inline JSON.
ORBIT_AGENT_KEYS_FILE=./keys.example.json
# ORBIT_AGENT_KEYS={"keys":{"orbit_sk_dev_agent1":{"agentId":"agent_dev1"}}}

# stdio only: the key this process authenticates as (must exist in the registry).
ORBIT_API_KEY=orbit_sk_dev_agent1

# ── HTTP transport ───────────────────────────────────────────────────────────
ORBIT_HTTP_PORT=8787
ORBIT_HTTP_PATH=/mcp
# Comma-separated CORS origin allowlist (e.g. the Vercel domain). "*" allows all.
ORBIT_CORS_ORIGINS=

# ── Logging ──────────────────────────────────────────────────────────────────
# debug | info | warn | error  (always written to stderr)
ORBIT_LOG_LEVEL=info
