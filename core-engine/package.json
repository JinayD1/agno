{
  "name": "orbit",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "test": "bun test",
    "dev": "bun --watch apps/api/src/index.ts",
    "start": "bun apps/api/src/index.ts",
    "migrate": "bun apps/api/src/db/migrate.ts",
    "seed": "bun apps/api/src/seed.ts"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/bun": "latest"
  }
}
