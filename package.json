{
  "name": "orbit",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "bootstrap": "bun scripts/bootstrap.ts",
    "dev": "bash scripts/dev-all.sh",
    "dev:api": "PORT=3001 bun --watch apps/api/src/index.ts",
    "dev:mcp": "bun --env-file=apps/mcp-server/.env --watch apps/mcp-server/src/index.ts",
    "dev:web": "cd web && bunx vite --port 5173"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
